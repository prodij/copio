# One file drives the app, Zitadel and Lago: run `make brand` after editing.
name: {{ product_name | tojson }}
font: {{ brand_font | tojson }}
logo: logo.svg
# font is a name, and the browser needs it installed. To load it for everyone, add the file:
# font_file: Inter.woff2   # optional; served by the app and uploaded to Zitadel (ttf, otf, woff, woff2; Zitadel's limit is 512 KB)
light:
  primary: {{ brand_primary | tojson }}
  accent: {{ brand_accent | tojson }}
  # background: "#ffffff"
  # foreground: "#111114"
# dark: optional; computed from light when omitted
#   primary / accent: 25% lighter than light, background: "#0b0b0c", foreground: "#ececee"
