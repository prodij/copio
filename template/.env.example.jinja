# Names only. `make env` copies this to .env (git-ignored), fills every `# Default:` and
# `# Generate:` value, and leaves the Stripe key for you to paste. Never commit .env.

# Stripe TEST mode secret key only (sk_test_..., restricted rk_test_ keys are refused):
# https://dashboard.stripe.com/test/apikeys
# The backend, Lago and `stripe listen` all use this one key.
STRIPE_SECRET_KEY=

# Host ports. Change any that another project on this machine already uses, then `make up`.
# Default: 5173
APP_PORT=
# Default: 8000
API_PORT=
# Default: 8085
ZITADEL_PORT=
# Default: 3100
ZITADEL_LOGIN_PORT=
# Default: 3000
LAGO_API_PORT=
# Default: 8088
LAGO_FRONT_PORT=
# Default: 5432
POSTGRES_PORT=
# Default: 8333
S3_PORT=

# Zitadel (exactly 32 characters)
# Generate: openssl rand -hex 16
ZITADEL_MASTERKEY=
# Generate: openssl rand -base64 32
LOGIN_SESSION_COOKIE_SECRET=
# Password of the Zitadel console admin (admin@{{ domain }}). Read only on the first `make up`.
# Generate: password 24
ZITADEL_ADMIN_PASSWORD=

# Local S3 (SeaweedFS) identity, used by the jobs
# Generate: openssl rand -hex 10
S3_ACCESS_KEY=
# Generate: openssl rand -hex 20
S3_SECRET_KEY=

# Lago
# Generate: openssl rand -hex 64
SECRET_KEY_BASE=
# Generate: openssl genrsa 2048 | openssl base64 -A
LAGO_RSA_PRIVATE_KEY=
# Generate: openssl rand -hex 16
LAGO_ENCRYPTION_PRIMARY_KEY=
# Generate: openssl rand -hex 16
LAGO_ENCRYPTION_DETERMINISTIC_KEY=
# Generate: openssl rand -hex 16
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=
# Generate: openssl rand -hex 24
LAGO_API_KEY=
# Default: admin@{{ domain }}
LAGO_ORG_USER_EMAIL=
# Generate: openssl rand -hex 16
LAGO_ORG_USER_PASSWORD=
