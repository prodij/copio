# Names only. `make env` copies this to .env (git-ignored), fills every `# Default:` and
# `# Generate:` value, and leaves the optional Stripe key empty. Never commit .env.

# Optional. Empty: the app works, but billing isn't set up, so plans can't be bought and paid
# features stay off. To add it later, paste the key here and run `make bootstrap` again.
# Stripe TEST mode secret key only (sk_test_..., restricted rk_test_ keys are refused):
# https://dashboard.stripe.com/test/apikeys
# The backend, Lago and `stripe listen` all use this one key.
STRIPE_SECRET_KEY=

# Mock payment, for local tests with no Stripe account. Both stay empty unless you want it. Set
# BILLING_MODE to mock and APP_ENV to local (with STRIPE_SECRET_KEY empty), then `make up && make bootstrap`.
# The backend and bootstrap refuse anything else. Nothing is charged, and real Lago and its signed webhook
# still decide access, but a mock payment pass is not a Stripe pass.
BILLING_MODE=
APP_ENV=

# Host ports. `make env` moves them all up by a step when a default is taken on this machine.
# To change one later, edit it in .env (not .env.example), then `make up && make bootstrap`.
# Default: 5173
APP_PORT=
# Default: 8000
API_PORT=
# Default: 8085
ZITADEL_PORT=
# Default: 3100
ZITADEL_LOGIN_PORT=
# Default: 3000
LAGO_API_PORT=
# Default: 8088
LAGO_FRONT_PORT=
# Default: 5432
POSTGRES_PORT=
# Default: 8333
S3_PORT=

# Zitadel (exactly 32 characters)
# Generate: openssl rand -hex 16
ZITADEL_MASTERKEY=
# Generate: openssl rand -base64 32
LOGIN_SESSION_COOKIE_SECRET=
# Password of the Zitadel console admin (admin@{{ domain }}). Read only on the first `make up`.
# Generate: password 24
ZITADEL_ADMIN_PASSWORD=

# Local S3 (SeaweedFS) identity, used by the jobs
# Generate: openssl rand -hex 10
S3_ACCESS_KEY=
# Generate: openssl rand -hex 20
S3_SECRET_KEY=

# Lago
# Generate: openssl rand -hex 64
SECRET_KEY_BASE=
# Generate: openssl genrsa 2048 | openssl base64 -A
LAGO_RSA_PRIVATE_KEY=
# Generate: openssl rand -hex 16
LAGO_ENCRYPTION_PRIMARY_KEY=
# Generate: openssl rand -hex 16
LAGO_ENCRYPTION_DETERMINISTIC_KEY=
# Generate: openssl rand -hex 16
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=
# Generate: openssl rand -hex 24
LAGO_API_KEY=
# Default: admin@{{ domain }}
LAGO_ORG_USER_EMAIL=
# Generate: openssl rand -hex 16
LAGO_ORG_USER_PASSWORD=
