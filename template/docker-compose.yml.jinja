# Local stack for {{ product_name }}. `make env` writes .env, `make up` starts this, `make bootstrap`
# configures Zitadel and Lago once. Host ports come from .env (see .env.example) so they can be moved
# off ports another project already uses.
name: {{ product_slug }}

x-lago-env: &lago-env
  DATABASE_URL: postgresql://lago:lago@postgres:5432/lago
  REDIS_URL: redis://redis:6379
  LAGO_REDIS_CACHE_URL: redis://redis:6379
  SECRET_KEY_BASE: ${SECRET_KEY_BASE}
  LAGO_RSA_PRIVATE_KEY: ${LAGO_RSA_PRIVATE_KEY}
  LAGO_ENCRYPTION_PRIMARY_KEY: ${LAGO_ENCRYPTION_PRIMARY_KEY}
  LAGO_ENCRYPTION_DETERMINISTIC_KEY: ${LAGO_ENCRYPTION_DETERMINISTIC_KEY}
  LAGO_ENCRYPTION_KEY_DERIVATION_SALT: ${LAGO_ENCRYPTION_KEY_DERIVATION_SALT}
  # Public URL: the issuer of Lago's webhook JWTs and the API the Lago UI calls from the browser.
  LAGO_API_URL: http://lago-api.{{ domain }}:${LAGO_API_PORT:-3000}
  LAGO_FRONT_URL: http://lago.{{ domain }}:${LAGO_FRONT_PORT:-8088}
  LAGO_PDF_URL: http://lago-pdf:3000
  LAGO_WEBHOOK_ALLOW_PRIVATE_URLS: "true"
  LAGO_DISABLE_SEGMENT: "true"
  LAGO_DISABLE_SIGNUP: "true"
  LAGO_CREATE_ORG: "true"
  LAGO_ORG_NAME: "{{ product_name }}"
  LAGO_ORG_USER_EMAIL: ${LAGO_ORG_USER_EMAIL}
  LAGO_ORG_USER_PASSWORD: ${LAGO_ORG_USER_PASSWORD}
  LAGO_ORG_API_KEY: ${LAGO_API_KEY}
  RAILS_ENV: production
  RAILS_LOG_TO_STDOUT: "true"

x-zitadel-url: &zitadel-url http://auth.{{ domain }}:${ZITADEL_PORT:-8085}

services:
  postgres:
    image: getlago/postgres-partman:15.0-alpine
    environment: {POSTGRES_USER: postgres, POSTGRES_PASSWORD: postgres}
    volumes:
      - pg:/var/lib/postgresql/data
      - ./scripts/postgres-init.sql:/docker-entrypoint-initdb.d/init.sql:ro
    ports: ["127.0.0.1:${POSTGRES_PORT:-5432}:5432"]
    healthcheck: {test: ["CMD", "pg_isready", "-U", "postgres"], interval: 3s, retries: 30}

  redis:
    image: redis:7-alpine
    healthcheck: {test: ["CMD", "redis-cli", "ping"], interval: 3s, retries: 30}

  # S3-compatible object storage for the jobs' raw-first data (SeaweedFS: master, volume, filer and
  # S3 gateway in one process). The S3 identity comes from .env; `make bootstrap` creates the bucket.
  s3:
    image: chrislusf/seaweedfs:3.97
    entrypoint: ["/bin/sh", "-c"]
    command:
      - >-
        printf '{"identities":[{"name":"app","credentials":[{"accessKey":"%s","secretKey":"%s"}],"actions":["Admin","Read","Write","List","Tagging"]}]}'
        "$$S3_ACCESS_KEY" "$$S3_SECRET_KEY" > /tmp/s3.json &&
        exec weed -logtostderr=true server -dir=/data -volume.max=0 -master.volumeSizeLimitMB=1024
        -s3 -s3.port=8333 -s3.config=/tmp/s3.json
    environment:
      S3_ACCESS_KEY: ${S3_ACCESS_KEY}
      S3_SECRET_KEY: ${S3_SECRET_KEY}
    volumes: [s3:/data]
    ports: ["127.0.0.1:${S3_PORT:-8333}:8333"]
    healthcheck: {test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8333/status"], interval: 3s, retries: 40}

  zitadel-api:
    image: ghcr.io/zitadel/zitadel:v4.20.0
    # Runs as the host user so the PATs it writes into ./.bootstrap/zitadel are readable on the host.
    user: "${HOST_UID:-1000}:${HOST_GID:-1000}"
    command: start-from-init --masterkeyFromEnv --tlsMode disabled
    environment:
      ZITADEL_MASTERKEY: ${ZITADEL_MASTERKEY}
      # Zitadel listens on the same port it is published on, so the issuer URL
      # http://auth.{{ domain }}:<port> works from the browser, the host and other containers alike.
      ZITADEL_PORT: ${ZITADEL_PORT:-8085}
      ZITADEL_EXTERNALDOMAIN: auth.{{ domain }}
      ZITADEL_EXTERNALPORT: ${ZITADEL_PORT:-8085}
      ZITADEL_EXTERNALSECURE: "false"
      ZITADEL_TLS_ENABLED: "false"  # also read by the `zitadel ready` healthcheck
      ZITADEL_DATABASE_POSTGRES_HOST: postgres
      ZITADEL_DATABASE_POSTGRES_PORT: 5432
      ZITADEL_DATABASE_POSTGRES_DATABASE: zitadel
      ZITADEL_DATABASE_POSTGRES_USER_USERNAME: zitadel
      ZITADEL_DATABASE_POSTGRES_USER_PASSWORD: zitadel
      ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE: disable
      ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME: postgres
      ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD: postgres
      ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE: disable
      ZITADEL_FIRSTINSTANCE_ORG_NAME: "{{ product_name }}"
      # The console admin: a plain login name and the generated password from .env, not Zitadel's default.
      ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME: admin@{{ domain }}
      ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD: ${ZITADEL_ADMIN_PASSWORD}
      ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORDCHANGEREQUIRED: "false"
      ZITADEL_FIRSTINSTANCE_PATPATH: /zitadel/bootstrap/admin.pat
      ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINE_USERNAME: bootstrap-admin
      ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINE_NAME: Bootstrap admin
      ZITADEL_FIRSTINSTANCE_ORG_MACHINE_PAT_EXPIRATIONDATE: "2099-01-01T00:00:00Z"
      ZITADEL_FIRSTINSTANCE_LOGINCLIENTPATPATH: /zitadel/bootstrap/login-client.pat
      ZITADEL_FIRSTINSTANCE_ORG_LOGINCLIENT_MACHINE_USERNAME: login-client
      ZITADEL_FIRSTINSTANCE_ORG_LOGINCLIENT_MACHINE_NAME: Login client
      ZITADEL_FIRSTINSTANCE_ORG_LOGINCLIENT_PAT_EXPIRATIONDATE: "2099-01-01T00:00:00Z"
      ZITADEL_DEFAULTINSTANCE_FEATURES_LOGINV2_REQUIRED: "true"
      ZITADEL_DEFAULTINSTANCE_FEATURES_LOGINV2_BASEURI: http://auth.{{ domain }}:${ZITADEL_LOGIN_PORT:-3100}/ui/v2/login/
      ZITADEL_OIDC_DEFAULTLOGINURLV2: http://auth.{{ domain }}:${ZITADEL_LOGIN_PORT:-3100}/ui/v2/login/login?authRequest=
      ZITADEL_OIDC_DEFAULTLOGOUTURLV2: http://auth.{{ domain }}:${ZITADEL_LOGIN_PORT:-3100}/ui/v2/login/logout?post_logout_redirect=
    volumes: [./.bootstrap/zitadel:/zitadel/bootstrap]
    ports: ["127.0.0.1:${ZITADEL_PORT:-8085}:${ZITADEL_PORT:-8085}"]
    networks:
      default:
        # Zitadel picks the instance by Host, so containers call it by its public name.
        aliases: [auth.{{ domain }}]
    depends_on: {postgres: {condition: service_healthy}}
    healthcheck: {test: ["CMD", "/app/zitadel", "ready"], interval: 5s, retries: 60, start_period: 10s}

  zitadel-login:
    image: ghcr.io/zitadel/zitadel-login:v4.20.0
    environment:
      ZITADEL_API_URL: *zitadel-url
      ZITADEL_SERVICE_USER_TOKEN_FILE: /zitadel/bootstrap/login-client.pat
      ZITADEL_SESSION_COOKIE_SECRET: ${LOGIN_SESSION_COOKIE_SECRET}
    volumes: [./.bootstrap/zitadel:/zitadel/bootstrap:ro]
    ports: ["127.0.0.1:${ZITADEL_LOGIN_PORT:-3100}:3000"]
    depends_on: {zitadel-api: {condition: service_healthy}}

  lago-migrate:
    image: getlago/api:v1.55.0
    command: ["./scripts/migrate.sh"]
    environment: *lago-env
    depends_on: {postgres: {condition: service_healthy}, redis: {condition: service_healthy}}

  lago-api:
    image: getlago/api:v1.55.0
    command: ["./scripts/start.api.sh"]
    environment: *lago-env
    volumes: [lago-storage:/app/storage]
    ports: ["127.0.0.1:${LAGO_API_PORT:-3000}:3000"]
    depends_on: {lago-migrate: {condition: service_completed_successfully}}
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:3000/health || exit 1"]
      interval: 5s
      retries: 60

  lago-worker:
    image: getlago/api:v1.55.0
    command: ["./scripts/start.worker.sh"]
    environment: *lago-env
    volumes: [lago-storage:/app/storage]
    depends_on: {lago-migrate: {condition: service_completed_successfully}}

  lago-clock:
    image: getlago/api:v1.55.0
    command: ["./scripts/start.clock.sh"]
    environment: *lago-env
    depends_on: {lago-migrate: {condition: service_completed_successfully}}

  lago-front:
    image: getlago/front:v1.55.0
    environment:
      API_URL: http://lago-api.{{ domain }}:${LAGO_API_PORT:-3000}
      APP_ENV: production
      LAGO_DISABLE_SIGNUP: "true"
    ports: ["127.0.0.1:${LAGO_FRONT_PORT:-8088}:80"]

  lago-pdf:
    image: getlago/lago-gotenberg:7.8.2

  # Forwards Stripe test webhooks to Lago (scripts/stripe-listen.sh). It needs the Lago organization
  # id, which `make bootstrap` writes to .bootstrap/ids.env before recreating this service.
  stripe-cli:
    image: stripe/stripe-cli:v1.55.6
    entrypoint: ["/bin/sh", "/stripe-listen.sh"]
    restart: on-failure:5
    env_file: [{path: .bootstrap/ids.env, required: false}]
    environment:
      STRIPE_API_KEY: ${STRIPE_SECRET_KEY:-}
      STRIPE_DEVICE_NAME: {{ product_slug }}-local
    volumes: [./scripts/stripe-listen.sh:/stripe-listen.sh:ro]

  backend:
    build: ./backend
    restart: unless-stopped
    env_file: [{path: .bootstrap/ids.env, required: false}]
    environment:
      DATABASE_URL: postgresql+psycopg://app:app@postgres:5432/app
      FRONTEND_URL: http://{{ domain }}:${APP_PORT:-5173}
      ZITADEL_ISSUER: *zitadel-url
      ZITADEL_API_URL: *zitadel-url
      ZITADEL_SERVICE_TOKEN_FILE: /run/bootstrap/backend.pat
      LAGO_API_URL: http://lago-api:3000
      LAGO_API_KEY: ${LAGO_API_KEY}
      LAGO_WEBHOOK_ISSUER: http://lago-api.{{ domain }}:${LAGO_API_PORT:-3000}
      STRIPE_SECRET_KEY: ${STRIPE_SECRET_KEY}
    volumes: [./.bootstrap/backend:/run/bootstrap:ro]
    ports: ["127.0.0.1:${API_PORT:-8000}:8000"]
    depends_on: {postgres: {condition: service_healthy}}

  jobs:
    build: ./jobs
    restart: unless-stopped
    environment:
      DATABASE_URL: postgresql+psycopg://app:app@postgres:5432/app
      LAGO_API_URL: http://lago-api:3000
      LAGO_API_KEY: ${LAGO_API_KEY}
      S3_ENDPOINT_URL: http://s3:8333
      AWS_ACCESS_KEY_ID: ${S3_ACCESS_KEY}
      AWS_SECRET_ACCESS_KEY: ${S3_SECRET_KEY}
      AWS_DEFAULT_REGION: us-east-1
      RAW_BUCKET: raw
    depends_on: {postgres: {condition: service_healthy}}

  frontend:
    image: node:22.23.2-alpine
    working_dir: /app
    command: sh -c "npm ci --no-audit --no-fund && npm run dev"
    # Vite exposes every VITE_* and ZITADEL_* variable to the browser, so this container gets only
    # public values: the issuer, and the client and project ids from .bootstrap/frontend.env.
    env_file: [{path: .bootstrap/frontend.env, required: false}]
    environment:
      VITE_API_BASE_URL: http://api.{{ domain }}:${API_PORT:-8000}
      ZITADEL_ISSUER: *zitadel-url
    volumes:
      - ./frontend:/app
      # Linux node_modules stay in the container; the host's (macOS) node_modules are left alone.
      - /app/node_modules
    ports: ["127.0.0.1:${APP_PORT:-5173}:5173"]

volumes: {pg: {}, s3: {}, lago-storage: {}}
