{
  "components": {
    "schemas": {
      "AccessOut": {
        "description": "`state` is the subscription's own state (including `pending`); `features` holds only what it grants now.\n\n`billing_configured` false: no Stripe key and no mock payment, so plans can't be bought. `mock_payment`\ntrue: payments are faked, so the UI labels them. Neither grants anything by itself.",
        "properties": {
          "billing_configured": {
            "title": "Billing Configured",
            "type": "boolean"
          },
          "current_period_end": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Period End"
          },
          "features": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Features",
            "type": "object"
          },
          "mock_payment": {
            "title": "Mock Payment",
            "type": "boolean"
          },
          "plan_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Code"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          }
        },
        "required": [
          "billing_configured",
          "mock_payment",
          "plan_code",
          "state",
          "current_period_end",
          "features"
        ],
        "title": "AccessOut",
        "type": "object"
      },
      "CheckoutIn": {
        "properties": {
          "plan_code": {
            "title": "Plan Code",
            "type": "string"
          }
        },
        "required": [
          "plan_code"
        ],
        "title": "CheckoutIn",
        "type": "object"
      },
      "CheckoutOut": {
        "description": "`checkout_url` null: no redirect needed (card already saved, subscription created or under way).",
        "properties": {
          "checkout_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkout Url"
          }
        },
        "required": [
          "checkout_url"
        ],
        "title": "CheckoutOut",
        "type": "object"
      },
      "ConnectionOut": {
        "description": "Never carries a credential: only whether one is stored and when it expires.",
        "properties": {
          "account_ref": {
            "title": "Account Ref",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "credential_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credential Expires At"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "has_credential": {
            "title": "Has Credential",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "schedules": {
            "items": {
              "$ref": "#/components/schemas/ScheduleOut"
            },
            "title": "Schedules",
            "type": "array"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "state_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "State Reason"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "provider",
          "account_ref",
          "display_name",
          "state",
          "state_reason",
          "scopes",
          "created_at",
          "updated_at",
          "has_credential",
          "credential_expires_at",
          "schedules"
        ],
        "title": "ConnectionOut",
        "type": "object"
      },
      "CreateConnection": {
        "properties": {
          "account_ref": {
            "maxLength": 255,
            "minLength": 1,
