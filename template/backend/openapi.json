{
  "components": {
    "schemas": {
      "AccessOut": {
        "description": "`state` is the subscription's own state (including `pending`); `features` holds only what it grants now.\n\n`billing_configured` false: no Stripe key, so plans can't be bought. It grants nothing by itself.",
        "properties": {
          "billing_configured": {
            "title": "Billing Configured",
            "type": "boolean"
          },
          "current_period_end": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Period End"
          },
          "features": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Features",
            "type": "object"
          },
          "plan_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Code"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          }
        },
        "required": [
          "billing_configured",
          "plan_code",
          "state",
          "current_period_end",
          "features"
        ],
        "title": "AccessOut",
        "type": "object"
      },
      "CheckoutIn": {
        "properties": {
          "plan_code": {
            "title": "Plan Code",
            "type": "string"
          }
        },
        "required": [
          "plan_code"
        ],
        "title": "CheckoutIn",
        "type": "object"
      },
      "CheckoutOut": {
        "description": "`checkout_url` null: no redirect needed (card already saved, subscription created or under way).",
        "properties": {
          "checkout_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkout Url"
          }
        },
        "required": [
          "checkout_url"
        ],
        "title": "CheckoutOut",
        "type": "object"
      },
      "CreateWorkspace": {
        "properties": {
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "CreateWorkspace",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          },
          "workspace": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MeWorkspace"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "user_id",
          "email",
          "workspace"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "MeWorkspace": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ],
        "title": "MeWorkspace",
        "type": "object"
      },
      "PlanOut": {
        "properties": {
          "amount_cents": {
            "title": "Amount Cents",
            "type": "integer"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "features": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Features",
            "type": "object"
          },
          "interval": {
            "title": "Interval",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "amount_cents",
          "currency",
          "interval",
          "features"
        ],
        "title": "PlanOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkspaceOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status"
        ],
        "title": "WorkspaceOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "api",
