          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "title": "Scopes",
            "type": "array"
          }
        },
        "required": [
          "provider",
          "account_ref",
          "display_name",
          "credentials"
        ],
