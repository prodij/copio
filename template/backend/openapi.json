    "/billing/webhooks/lago": {
      "post": {
        "description": "Async only to read the raw body (the signature covers it); verifying and the DB work run in a thread.",
        "operationId": "lago_webhook_billing_webhooks_lago_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-lago-signature",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Lago-Signature"
            }
          },
          {
            "in": "header",
            "name": "x-lago-unique-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Lago-Unique-Key"
            }
          },
          {
            "in": "header",
            "name": "x-lago-signature-algorithm",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Lago-Signature-Algorithm"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Lago Webhook Billing Webhooks Lago Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Lago Webhook"
      }
    },
