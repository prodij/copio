FROM node:22-alpine

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace config
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY tsconfig.base.json ./

# Copy package.json files AND prisma schema (needed for postinstall)
COPY packages/core/package.json ./packages/core/
COPY packages/core/prisma ./packages/core/prisma
COPY packages/inventory-service/package.json ./packages/inventory-service/

# Install all dependencies
RUN pnpm install

# Copy remaining source code
COPY packages/core/src ./packages/core/src
COPY packages/core/tsconfig.json ./packages/core/
COPY packages/inventory-service ./packages/inventory-service

# Generate Prisma client
RUN pnpm --filter @copio/core db:generate

# Build core package
RUN pnpm --filter @copio/core build

WORKDIR /app/packages/inventory-service

EXPOSE 3002

CMD ["pnpm", "dev"]
