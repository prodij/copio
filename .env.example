# Copio Phase 1.0 — single-tenant against founder's Nutragroup account.
# Copy to .env and fill in real values. Never commit .env.

# ---- Postgres (local dev via docker-compose.dev.yml) ----
POSTGRES_DB=copio
POSTGRES_USER=copio
POSTGRES_PASSWORD=copio_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://copio:copio_dev@localhost:5435/copio

# ---- Anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-7

# ---- Amazon SP-API (LWA) ----
# Get these from your SP-API developer registration.
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
LWA_REFRESH_TOKEN=
SPAPI_REGION=NA
SPAPI_MARKETPLACE_ID=ATVPDKIKX0DER
SPAPI_SELLER_ID=

# Phase 1.0 single-tenant: founder identity baked in.
FOUNDER_TENANT_ID=nutragroup
FOUNDER_DISPLAY_NAME=James

# ---- Inngest (local dev) ----
INNGEST_DEV_SERVER_URL=http://localhost:8288
INNGEST_EVENT_KEY=copio-dev
INNGEST_SIGNING_KEY=copio-dev-signing-key

# ---- Web ----
WEB_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8001
